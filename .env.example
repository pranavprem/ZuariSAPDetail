# Copy to .env and fill in values for the SAP application server.
# .env is ignored by git. Do not commit logon details or host names.

SAP_ASHOST=
SAP_SYSNR=
SAP_CLIENT=
SAP_USER=
SAP_PASSWD=

# Optional. Omit to let the SAP system choose the default language.
SAP_LANG=EN

# Set to 1 to render sample personnel numbers without calling SAP.
# Leave this off anywhere the page is reachable by other people.
SAP_DEMO=0
